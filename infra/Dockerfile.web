# Serves the prerendered SvelteKit build. No build stage on purpose: the build comes as an
# artifact from the web-quality job (one build, one artifact, one image; KONZEPT 8.3).
# Local: (cd web && npm ci && npm run build) && docker build -f infra/Dockerfile.web -t politdrift-web .
FROM nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03

LABEL org.opencontainers.image.source="https://github.com/michschl/politdrift" \
      org.opencontainers.image.title="politdrift-web" \
      org.opencontainers.image.description="Politdrift static website"

# Pull Alpine security fixes that are newer than the pinned base image. Trivy blocks the
# build on fixable HIGH/CRITICAL findings; upstream rebuilds lag behind Alpine updates.
USER root
RUN apk upgrade --no-cache

COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY web/build/ /usr/share/nginx/html/

USER 101
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
